<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_type_form_classification" model="ir.ui.view">
        <field name="name">stock.picking.type.form.classification</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_classification" invisible="code != 'mrp_operation'" />
            </xpath>
        </field>
    </record>
</odoo>
