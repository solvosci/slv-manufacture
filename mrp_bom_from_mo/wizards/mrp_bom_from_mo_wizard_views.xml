<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_bom_from_mo_wizard_form" model="ir.ui.view">
        <field name="name">mrp.bom.from.mo.wizard.form</field>
        <field name="model">mrp.bom.from.mo.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Bill of Materials">
                <field name="production_id" invisible="1"/>
                <group>
                    <group>
                        <field
                            name="code"
                            string="Reference"
                            placeholder="e.g. v1.0"
                        />
                    </group>
                    <group>
                        <field
                            name="log_in_chatter"
                            groups="base.group_no_one"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_create_bom"
                        type="object"
                        string="Create Bill of Materials"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
