<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_operation_tree_suggest_name" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.suggest.name</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <button name="action_suggest_lot_name_move" type="object"
                    icon="fa-magic"
                    column_invisible="parent.has_tracking == 'none' or not parent.show_lots_text"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_suggest_name" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.suggest.name</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <button name="action_suggest_lot_name_picking" type="object"
                    icon="fa-magic"
                    column_invisible="context.get('picking_code') != 'incoming' or not context.get('show_lots_text')"/>
            </field>
        </field>
    </record>

</odoo>
