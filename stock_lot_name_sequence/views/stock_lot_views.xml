<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_lot_form_smart_name" model="ir.ui.view">
        <field name="name">stock.lot.form.smart.name</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1/field[@name='name']" position="after">
                <button name="action_suggest_name" type="object"
                        string="Suggest Name" icon="fa-magic"
                        invisible="not product_id or not id"/>
            </xpath>
        </field>
    </record>

</odoo>
