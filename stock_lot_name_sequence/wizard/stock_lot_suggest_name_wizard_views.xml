<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_suggest_name_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.suggest.name.wizard.form</field>
        <field name="model">stock.lot.suggest.name.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="lot_id" invisible="1"/>
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="current_name"/>
                    <field name="suggested_name"/>
                </group>
                <footer>
                    <button name="button_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
