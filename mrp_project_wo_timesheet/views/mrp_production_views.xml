<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_view_mrp_production_timesheet" model="ir.actions.act_window">
        <field name="name">Timesheet </field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('mrp_production_id', '=', active_id)]</field>
    </record>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form (in mrp_project_wo_timesheet)</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="%(action_view_mrp_production_timesheet)d" type="action" icon="fa-clock-o" attrs="{'invisible': [('wp_timesheet_count', '=', 0)]}" groups="hr_timesheet.group_hr_timesheet_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="wp_timesheet_count"/></span>
                        <span class="o_stat_text">Timesheet</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
