<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.maintenance (in mdc_weight_mgmt)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Weight Management"
                    string="Weight Management"
                    name="mdc_weight_mgmt"
                    groups="mdc_weight_mgmt.group_mdc_weight_mgmt_responsible">
                    <block title="Weight Management">
                        <setting help="Select the default product category for weight management.">
                            <field name="product_categ_default_id" />
                        </setting>
                        <setting help="Select the default equipment category for weight management.">
                            <field name="equipment_category_default_id" />
                        </setting>
                        <setting help="Select the image you want to display in the template.">
                            <field name="image_logo_template" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
