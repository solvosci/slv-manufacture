<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="mdc_weight_mgmt_module">
            <field name="name">Weight Management</field>
            <field name="description">User access levels for Weight Management module</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_mdc_weight_mgmt_user_readonly" model="res.groups">
            <field name="name">User Readonly</field>
            <field name="category_id" ref="mdc_weight_mgmt_module" />
        </record>

        <record id="group_mdc_weight_mgmt_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="mdc_weight_mgmt_module" />
            <field name="implied_ids" eval="[(4, ref('group_mdc_weight_mgmt_user_readonly'))]" />
        </record>

        <record id="group_mdc_weight_mgmt_responsible" model="res.groups">
            <field name="name">Responsible</field>
            <field name="category_id" ref="mdc_weight_mgmt_module" />
            <field name="implied_ids" eval="[(4, ref('group_mdc_weight_mgmt_user'))]" />
            <field name="users" eval="[(4, ref('base.user_root')), (4,ref('base.user_admin'))]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="mdc_weight_record_multi_company_rule" model="ir.rule">
            <field name="name">Weight Records multi-company</field>
            <field name="model_id" ref="model_mdc_weight_record" />
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in',
                company_ids)]</field>
        </record>
    </data>
</odoo>
