<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_workorder_tree_editable_view" model="ir.ui.view">
        <field name="name">mrp.production.work.order.tree.editable (in mrp_workorder_last_instruction)</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <field name="duration" position="before">
                <field name="last_technical_instruction_point_user_id" string="Last Tech. Ins. P User" readonly="1" optional="show"/>
                <field name="last_technical_instruction_point" string="Last Tech. Ins. P." readonly="1" optional="show"/>
            </field>
        </field>
    </record>

    <record id="mrp_production_workorder_form_view_inherit" model="ir.ui.view">
        <field name="name">	mrp.production.work.order.form (in mrp_workorder_last_instruction)</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <field name="duration" position="before">
                <field name="technical_instruction_point" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
