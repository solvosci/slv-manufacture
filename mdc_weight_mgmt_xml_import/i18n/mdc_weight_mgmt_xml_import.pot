#: model:mail.template,body_html:mdc_weight_mgmt_xml_import.email_template_xml_import_error_notification
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <p>\n"
"                        <strong>Errors where found while importing XML</strong>\n"
"                    </p>\n"
"                    <table border=\"1\" cellpadding=\"5\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n"
"                        <thead style=\"background-color: #f0f0f0;\">\n"
"                            <tr>\n"
"                                <th>Line</th>\n"
"                                <th>File</th>\n"
"                                <th>Error Message</th>\n"
"                                <th>Date</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <t t-foreach=\"ctx.get('error_list')\" t-as=\"err\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"err.equipment_id or '---'\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"err.file_name or '---'\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"err.error_message or '---'\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"err.create_date.strftime('%d-%m-%Y - %H:%M:%S') if err.create_date else '---'\"></t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </tbody>\n"
"                    </table>\n"
"                    <p style=\"margin-top: 20px;\">You can review these errors in the <a href=\"/web#action=mdc_weight_mgmt_xml_import.action_mdc_weight_record_error\" target=\"_blank\">Import errors</a> menu.\n"
"                    </p>\n"
"                </div>\n"
"            "
