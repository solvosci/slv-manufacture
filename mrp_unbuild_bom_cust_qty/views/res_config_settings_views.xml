<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form (in mrp_unbuild_bom_cust_qty)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='process_operations_setting_container']" position="inside">
                <setting help="When activated, unbuild product quantity is automatically updated when total BoM quants are added">
                    <field name="group_unbuild_force_exact_qty"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
