<odoo>
    <record id="mrp_unbuild_bom_total_view_tree" model="ir.ui.view">
        <field name="name">mrp.unbuild.bom.totals.view.tree</field>
        <field name="model">mrp.unbuild.bom.totals</field>
        <field name="arch" type="xml">
            <tree 
                string="Totals" 
                editable="top" 
                create="true" 
                delete="false" 
                decoration-danger="deco_danger == True"
                decoration-it="is_product_uom_diff"
            >
                <field name="company_id" column_invisible="1" />
                <field name="deco_danger" column_invisible="1" />
                <field name="check_bom_line" column_invisible="1" />
                <field name="unbuild_id" column_invisible="1" />
                <field name="bom_line_ids" column_invisible="1" />
                <field name="bom_id" column_invisible="1" />
                <field name="is_product_uom_diff" column_invisible="1" />
                <field name="bom_line_id"
                    domain="[('id', 'not in', bom_line_ids)]"
                    readonly="check_bom_line or total_qty > 0"
                />
                <field name="total_qty" />
                <field name="expected_qty" />
                <field
                    name="product_uom_id"
                    string="UoM"
                    groups="uom.group_uom"
                />
                <button name="product_weighing"
                    type="object"
                    icon="fa-refresh"
                    title="Add a weight"
                    invisible="parent.state == 'done'"
                />
                <button name="unlink"
                    class="o_list_record_remove"
                    type="object"
                    icon="fa-trash-o"
                    title="Remove the line"
                    invisible="check_bom_line or parent.state == 'done'"
                />
            </tree>
        </field>
    </record>
</odoo>
