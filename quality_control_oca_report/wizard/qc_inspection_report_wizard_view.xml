<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qc_report_wizard_form" model="ir.ui.view">
        <field name="name">qc.inspection.report.wizard.form</field>
        <field name="model">qc.inspection.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Quality Control Report">
                <group>
                    <field name="title" placeholder="Enter the title of the incident..."/>
                    <field name="description" widget="text" placeholder="Report notes..."/>
                </group>
                <group string="Images">
                    <field name="image_ids" widget="many2many_binary" string="Attach Images"/>
                    <!-- <field name="document_ids" widget="many2many_binary" string="Attach Documents"/> -->
                </group>
                <footer>
                    <button name="action_confirm_report" string="Generate PDF" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qc_report_wizard" model="ir.actions.act_window">
        <field name="name">Quality Control Report</field>
        <field name="res_model">qc.inspection.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
