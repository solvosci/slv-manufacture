<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="qc_inspection_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-set="insp" t-value="o.inspection_id"/>
                    <div class="page">
                    <style>
                        .qc_table { width: 100%; border: 1px solid black; border-collapse: collapse; margin-bottom: 20px; }
                        .qc_table td { border: 1px solid #dee2e6; padding: 8px; vertical-align: top; }
                        .qc_label { background-color: #f2f2f2; font-weight: bold; text-transform: uppercase; font-size: 10px; }
                    </style>
                    <table class="qc_table">
                        <tr>
                            <td rowspan="2" style="width: 30%; text-align: center; vertical-align: middle;">
                                <img
                                    t-if="res_company.logo"
                                    t-att-src="image_data_uri(res_company.logo)"
                                    style="max-height: 70px; max-width: 200px;"
                                />
                            </td>
                            <td class="qc_label">Test</td>
                            <td class="qc_label">Reference</td>
                        </tr>
                        <tr>
                            <td><span t-field="insp.test"/></td>
                            <td><span t-field="insp.name"/></td>
                        </tr>
                        <tr>
                            <td class="qc_label">Inspection State</td>
                            <td class="qc_label">Success</td>
                            <td class="qc_label">Employee</td>
                        </tr>
                        <tr>
                            <td><span t-field="insp.state"/></td>
                            <td><span t-field="insp.success"/></td>
                            <td><span t-field="insp.user.name"/></td>
                        </tr>
                        <div name="product" t-if="insp.product_id">
                            <tr>
                                <td class="qc_label">Product</td>
                                <td class="qc_label">Name</td>
                                <td class="qc_label">Quantity</td>
                            </tr>
                            <tr>
                                <td><span t-field="insp.product_id.default_code"/></td>
                                <td><span t-field="insp.product_id.name"/></td>
                                <td><span t-field="insp.qty"/></td>
                            </tr>
                        </div>
                    </table>

                    <div t-if="o.title or o.description">
                        <h4 style="border-bottom: 1px solid black; padding-bottom: 5px;">Report Details:</h4>
                        <table class="qc_table">
                            <tr>
                                <td class="qc_label" style="width: 20%;">Title</td>
                                <td><span t-field="o.title"/></td>
                            </tr>
                            <tr>
                                <td class="qc_label">Description</td>
                                <td><span t-field="o.description"/></td>
                            </tr>
                        </table>
                    </div>

                    <h4 style="margin-top: 20px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Inspection results:</h4>
                    <table class="qc_table">
                        <thead>
                            <tr>
                                <td class="qc_label" style="width: 70%;">DESCRIPTION</td>
                                <td class="qc_label" style="width: 30%;">VALUE</td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="insp.inspection_lines" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.name"/>
                                    </td>
                                    <td>
                                        <t t-if="line.test_line.type == 'qualitative'">
                                            <span t-field="line.qualitative_value"/>
                                        </t>
                                        <t t-if="line.test_line.type == 'quantitative'">
                                            <span t-field="line.quantitative_value"/> <span t-field="line.uom_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div t-if="o.image_ids" style="margin-top: 10px;">
                        <h4 style="margin-top: 20px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Images attached</h4>
                        <div class="row">
                            <t t-foreach="o.image_ids" t-as="img">
                                <div class="col-4 text-center" style="margin-bottom: 15px;">
                                    <img t-att-src="image_data_uri(img.datas)" style="max-width: 100%; border: 1px solid #ccc; padding: 5px;"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- <div t-if="o.document_ids" style="margin-top: 10px;">
                        <h4 style="margin-top: 20px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Documents attached</h4>
                            <t t-esc="', '.join(o.document_ids.mapped('name'))"/>
                    </div> -->
                    </div>
            </t>
        </t>
        </t>
    </template>
</odoo>
