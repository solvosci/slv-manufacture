<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form (in mrp_production_label_customization)</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//field[@name='date_deadline']" position="attributes">
                <attribute name="string">First MRP Date</attribute>
            </xpath>
            <label for="date_planned_start" position="attributes">
                <attribute name="string">Schedule Start Date</attribute>
            </label>
        </field>
    </record>

    <record id="mrp_production_tree_view" model="ir.ui.view">
        <field name="name">mrp.production.tree (in mrp_production_label_customization)</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp_production_date_planned_finished.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="attributes">
                <attribute name="string">First MRP Date</attribute>
                <attribute name="widget">date</attribute>
            </field>
            <field name="date_planned_start" position="attributes">
                <attribute name="string">Schedule Start Date</attribute>
                <attribute name="widget">date</attribute>
            </field>
            <field name="date_planned_finished" position="attributes">
                <attribute name="widget">date</attribute>
            </field>
        </field>
    </record>
</odoo>
