<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="quality_control_stock_oca.action_qc_inspection_per_picking" model="ir.actions.act_window">
        <field name="context">{
            'default_picking_id': active_id,
        }</field>
    </record>

    <record id="quality_control_stock_oca.action_qc_inspection_per_picking_done" model="ir.actions.act_window">
        <field name="context">{
            'default_picking_id': active_id,
        }</field>
    </record>

    <record id="quality_control_stock_oca.action_qc_inspection_per_picking_passed" model="ir.actions.act_window">
        <field name="context">{'default_picking_id': active_id}</field>
    </record>

    <record id="quality_control_stock_oca.action_qc_inspection_per_picking_failed" model="ir.actions.act_window">
        <field name="context">{'default_picking_id': active_id}</field>
    </record>

</odoo>
